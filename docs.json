{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Media Cloud API",
  "description": "API for uploading, listing, retrieving and deleting media assets on Media Cloud.",
  "colors": {
    "primary": "#00AFEF",
    "light": "#4DC7F5",
    "dark": "#4291D5"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "DM Sans"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/assets",
              "concepts/upload-and-delete"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "essentials/errors",
              "essentials/pagination"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "terminal",
        "groups": [
          {
            "group": "Assets",
            "pages": [
              "api-reference/assets/overview",
              "api-reference/assets/upload-asset",
              "api-reference/assets/bulk-upload-assets",
              "api-reference/assets/get-all-assets",
              "api-reference/assets/get-asset",
              "api-reference/assets/bulk-trash-assets",
              "api-reference/assets/bulk-delete-assets"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock-rotate-left",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    }
  ],
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Website",
      "href": "https://mediacloud.me"
    }
  },
  "footer": {
    "socials": {
      "website": "https://mediacloud.me"
    }
  }
}
